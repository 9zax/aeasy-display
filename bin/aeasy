#!/bin/zsh
# aeasy — ใช้มือถือ Android เป็นจอเสริม/จอ mirror ของ Mac ผ่านสาย USB-C
export PATH="/opt/homebrew/bin:$HOME/.local/bin:$PATH"  # nohup'd watcher has no shell profile
SHARE="$HOME/.local/share/aeasy"
SERVER="$SHARE/aeasy-server"
CONFIGAPP="$SHARE/aeasy-config"
APK="$SHARE/app-debug.apk"
CFG="$SHARE/config"
LOG="$SHARE/server.log"
APP=dev.ctz.usbdisplay
mkdir -p "$SHARE"  # config/log/dims live here; Homebrew installs don't run install.sh

# route every adb call to the wireless device when WIFI_ADDR is set (aeasy wifi)
adb() {
  local w=$(grep -m1 '^WIFI_ADDR=' "$CFG" 2>/dev/null | cut -d= -f2)
  command adb ${w:+-s "$w"} "$@"
}

plugged() { [[ "$(adb get-state 2>/dev/null)" == "device" ]] }
warn_unplugged() { echo "⚠️  No phone plugged in (USB-C) — connect the cable and try again" >&2 }

phone_rotation() {  # logical rotation; 'rotation N' alone can match the physical panel's (always 0)
  local d=$(adb shell dumpsys display 2>/dev/null)
  local r=$(echo "$d" | grep -oEm1 'mCurrentOrientation=[0-3]' | grep -oE '[0-3]')
  [[ -n "$r" ]] && echo "$r" || echo "$d" | grep -oEm1 'rotation [0-3]' | grep -oE '[0-3]' | head -1
}

phone_dims() {  # echoes "W H" matching current phone rotation
  local size=$(adb shell wm size | head -1 | awk '{print $3}')   # e.g. 720x1650
  local a=${size%x*} b=${size#*x}
  local small=$(( a < b ? a : b )) big=$(( a < b ? b : a ))
  local rot=$(phone_rotation)
  if [[ "$rot" == 0 || "$rot" == 2 ]]; then echo "$small $big"; else echo "$big $small"; fi
}

# SOURCES replaces the old exclusive MODE/WINDOW_APP pair; strip those so a stale
# value can never come back if SOURCES is later cleared
set_sources() {
  mkdir -p "$SHARE"
  { grep -vE '^(SOURCES|MODE|WINDOW_APP)=' "$CFG" 2>/dev/null; echo "SOURCES=$1"; } > "$CFG.tmp" && mv "$CFG.tmp" "$CFG"
}

server_start() {
  pkill -f aeasy-server 2>/dev/null
  local dims=($(phone_dims))
  echo "${dims[1]} ${dims[2]}" > "$SHARE/dims"
  "$SERVER" ${dims[1]} ${dims[2]} >>"$LOG" 2>&1 &!
  echo "🖥  Virtual display up ${dims[1]}x${dims[2]}"
}

app_open() {
  adb reverse tcp:7355 tcp:7355 >/dev/null 2>&1
  adb shell "pidof $APP >/dev/null || am start -n $APP/.MainActivity" >/dev/null 2>&1
}

watch_loop() {
  while true; do
    if plugged; then
      pgrep -qf aeasy-server || server_start
      app_open
      # rotate the virtual display only while our app is the focused one
      if adb shell dumpsys window 2>/dev/null | grep -m1 mCurrentFocus | grep -q "$APP"; then
        local cur=$(phone_dims)
        if [[ -n "$cur" && "$cur" != "$(cat "$SHARE/dims" 2>/dev/null)" ]]; then
          server_start
        fi
      fi
    else
      # wireless mode: try to reconnect before giving up this tick
      local w=$(grep -m1 '^WIFI_ADDR=' "$CFG" 2>/dev/null | cut -d= -f2)
      [[ -n "$w" ]] && command adb connect "$w" >/dev/null 2>&1
      # phone gone → tear down the virtual display until it's back
      plugged || { pgrep -qf aeasy-server && pkill -f aeasy-server }
    fi
    sleep 2
  done
}

case "${1:-start}" in
  start)
    if ! plugged; then warn_unplugged; exit 1; fi
    server_start
    sleep 1
    app_open
    pgrep -qf "aeasy _watch" || (nohup zsh "$0" _watch >/dev/null 2>&1 &!)
    pgrep -qf aeasy-tray || ("$SHARE/aeasy-tray" >/dev/null 2>&1 &!)
    echo "✅ Running — plug, unplug, or rotate freely (stop: aeasy stop)"
    ;;
  stop)
    pkill -f "aeasy _watch" 2>/dev/null
    pkill -f aeasy-server 2>/dev/null
    echo "⏹  Stopped"
    ;;
  restart)
    if ! plugged; then warn_unplugged; exit 1; fi
    server_start; sleep 1; app_open
    ;;
  app)
    if ! plugged; then warn_unplugged; exit 1; fi
    app_open && echo "📱 Viewer app launched on the phone"
    ;;
  mirror)
    if [[ -z "$2" ]]; then echo "usage: aeasy mirror <AppName>   e.g. aeasy mirror Safari"; exit 1; fi
    if ! plugged; then warn_unplugged; exit 1; fi
    set_sources "window:$2"
    server_start; sleep 1; app_open
    echo "🪞 Mirroring '$2' to the phone (back to extended: aeasy screen)"
    echo "   showing several at once: aeasy sources display,window:$2"
    ;;
  screen)
    set_sources "display"
    if plugged; then server_start; sleep 1; app_open; fi
    echo "🖥  Extended-display mode"
    ;;
  sources)
    if [[ -z "$2" ]]; then
      cur=$(grep -m1 '^SOURCES=' "$CFG" 2>/dev/null | cut -d= -f2-)
      if [[ -n "$cur" ]]; then echo "$cur"
      elif [[ "$(grep -m1 '^MODE=' "$CFG" 2>/dev/null | cut -d= -f2)" == "window" ]]; then
        echo "window:$(grep -m1 '^WINDOW_APP=' "$CFG" 2>/dev/null | cut -d= -f2)"
      else echo "display"; fi
      exit 0
    fi
    n=$(echo "$2" | tr ',' '\n' | grep -c .)
    if (( n > 3 )); then echo "⚠️  Maximum 3 sources — got $n ($2)" >&2; exit 1; fi
    set_sources "$2"
    echo "🧩 Sources: $2"
    # config-only edit works unplugged, like `aeasy screen`
    if plugged; then server_start; sleep 1; app_open; else echo "   (plug the phone in to apply)"; fi
    ;;
  status)
    W=$(grep -m1 '^WIFI_ADDR=' "$CFG" 2>/dev/null | cut -d= -f2)
    if [[ -n "$W" ]]; then
      if plugged; then echo "📶 Wireless: connected $W ($(adb shell getprop ro.product.model 2>/dev/null))"; else echo "📶 Wireless: not connected ($W)"; fi
    else
      if plugged; then echo "🔌 Cable: connected ($(adb shell getprop ro.product.model 2>/dev/null))"; else echo "🔌 Cable: not connected"; fi
    fi
    pgrep -qf aeasy-server && echo "🖥  Server: running" || echo "🖥  Server: stopped"
    # only this server run: the log is append-only and quality is auto-lowered live now,
    # so an old LAGGY line would recommend tuning forever
    if tail -r "$LOG" 2>/dev/null | sed -n '1,/listening on/p' | grep -q 'LAGGY'; then
      echo "🐢 Lag detected — quality was lowered automatically (secondary panes first)"
    fi
    pgrep -qf "aeasy _watch" && echo "👀 Watcher: running" || echo "👀 Watcher: stopped"
    plugged && { adb shell pidof $APP >/dev/null 2>&1 && echo "📱 Phone app: open" || echo "📱 Phone app: closed"; }
    [[ -f "$CFG" ]] && { echo "⚙️  config:"; sed 's/^/    /' "$CFG"; }
    true
    ;;
  config|--config)
    "$CONFIGAPP" &!
    echo "⚙️  Settings window opened"
    ;;
  tune)
    mkdir -p "$SHARE"
    { grep -vE '^(FPS|BITRATE|SCALE|AUTO)=' "$CFG" 2>/dev/null; echo "FPS=15"; echo "BITRATE=1500000"; echo "SCALE=60"; } > "$CFG.tmp" && mv "$CFG.tmp" "$CFG"
    echo "⚡ Low-latency preset: 15fps / 1.5Mbps / 60% resolution (good for budget phones)"
    echo "   fine-tune: aeasy config"
    if plugged; then server_start; sleep 1; app_open; fi
    ;;
  wifi)
    if [[ "$(command adb -d get-state 2>/dev/null)" != "device" ]]; then
      echo "⚠️  Plug in the USB cable first — it's only needed once to enable Wi-Fi mode" >&2; exit 1
    fi
    command adb -d tcpip 5555 >/dev/null; sleep 1
    IP=$(command adb -d shell ip route 2>/dev/null | awk '/wlan/ {print $9; exit}')
    if [[ -z "$IP" ]]; then echo "⚠️  Couldn't find the phone's IP — is it on Wi-Fi?" >&2; exit 1; fi
    command adb connect "$IP:5555" >/dev/null || { echo "⚠️  adb connect $IP:5555 failed" >&2; exit 1; }
    mkdir -p "$SHARE"
    { grep -vE '^WIFI_ADDR=' "$CFG" 2>/dev/null; echo "WIFI_ADDR=$IP:5555"; } > "$CFG.tmp" && mv "$CFG.tmp" "$CFG"
    echo "📶 Wireless mode on ($IP:5555) — you can unplug the cable now (back to USB: aeasy usb)"
    ;;
  usb)
    W=$(grep -m1 '^WIFI_ADDR=' "$CFG" 2>/dev/null | cut -d= -f2)
    [[ -n "$W" ]] && command adb disconnect "$W" >/dev/null 2>&1
    { grep -vE '^WIFI_ADDR=' "$CFG" 2>/dev/null; } > "$CFG.tmp" && mv "$CFG.tmp" "$CFG"
    echo "🔌 Back to USB mode"
    ;;
  install-app)
    if ! plugged; then warn_unplugged; exit 1; fi
    adb install -r "$APK" && echo "📱 App installed on the phone"
    ;;
  log)
    tail -20 "$LOG"
    ;;
  _watch)
    watch_loop
    ;;
  help|--help|-h)
    if [[ "$2" == "--th" || "$2" == "th" ]]; then
      cat <<'EOF'
aeasy — ใช้มือถือ Android เป็นจอเสริมของ Mac ผ่านสาย USB-C (alias: aez)

  aeasy start          เริ่มจอเสริม + เฝ้าสายอัตโนมัติ (เสียบสายปุ๊บแอปเด้งเอง, หมุนเครื่องได้)
  aeasy stop           หยุดทั้งหมด
  aeasy status         ดูสถานะ สาย / เซิร์ฟเวอร์ / แอปมือถือ / config
  aeasy app            เปิดแอปบนมือถือ (แจ้งเตือนถ้าไม่ได้เสียบสาย)
  aeasy mirror <แอพ>   mirror เฉพาะหน้าต่างแอพเดียว เช่น: aeasy mirror Safari
  aeasy screen         กลับเป็นโหมดจอเสริมเต็มจอ
  aeasy sources [ลิสต์] ดู/ตั้งแหล่งภาพได้สูงสุด 3 อัน แสดงซ้อนกันบนมือถือ
                       เช่น: aeasy sources display,window:Safari  (ลากจัดตำแหน่งได้ในแอปมือถือ)
  aeasy config         เปิดหน้าต่างตั้งค่า (fps / bitrate / ความละเอียด / โหมด)
  aeasy tune           ตั้งค่าโหมดลื่นสำหรับมือถือช้า (15fps / 60%) — ใช้เมื่อภาพหน่วง
  aeasy wifi           เปลี่ยนเป็นโหมดไร้สาย (เสียบสายครั้งเดียวตอนเปิดใช้ แล้วถอดได้เลย)
  aeasy usb            กลับมาใช้สาย USB
  aeasy restart        รีสตาร์ทจอเสมือน
  aeasy install-app    ติดตั้ง APK ลงมือถือ
  aeasy log            ดู log ล่าสุดของเซิร์ฟเวอร์
EOF
    else
      cat <<'EOF'
aeasy — use an Android phone as a second display for your Mac over USB-C (alias: aez)

  aeasy start          start the display + cable watcher (auto-launches the phone app, auto-rotates)
  aeasy stop           stop everything
  aeasy status         show cable / server / phone-app status and config
  aeasy app            launch the viewer app on the phone (warns if unplugged)
  aeasy mirror <App>   mirror a single app window, e.g.: aeasy mirror Safari
  aeasy screen         back to full extended-display mode
  aeasy sources [list] show/set up to 3 sources shown as panes on the phone
                       e.g.: aeasy sources display,window:Safari  (drag to arrange in the app)
  aeasy config         open the settings GUI (fps / bitrate / resolution / mode)
  aeasy tune           low-latency preset for slower phones (15fps / 60%) — use when laggy
  aeasy wifi           switch to wireless mode (cable needed once to enable, then unplug)
  aeasy usb            switch back to USB mode
  aeasy restart        restart the virtual display
  aeasy install-app    install the APK onto the phone
  aeasy log            tail the server log

  aeasy --help --th    แสดงเป็นภาษาไทย
EOF
    fi
    ;;
  *)
    echo "unknown command: $1 (see aeasy --help)"; exit 1 ;;
esac
